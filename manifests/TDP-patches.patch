+ {
+-	/* TODO: add L2 SEPT support */
+-	return -EOPNOTSUPP;
++	hpa_t l2sept_hpa[MAX_NUM_L2_VMS] = { [0 ... (MAX_NUM_L2_VMS - 1)] = INVALID_PAGE };
