+@@ -1936,8 +2014,86 @@ void tdx_deliver_interrupt(struct kvm_lapic *apic, int delivery_mode,
+ static int tdx_handle_l2sept_walking_failure(struct kvm_vcpu *vcpu, int tdx_level,
