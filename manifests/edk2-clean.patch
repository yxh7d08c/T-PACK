-/**
-  Function is used for mapping host address to device address. The buffer must
-  be unmapped with UnmapDmaDataBuffer ().
-
-**/
-STATIC
-VOID
-MapFwCfgDmaDataBuffer (
-  IN  BOOLEAN               IsWrite,
-  IN  VOID                  *HostAddress,
-  IN  UINT32                Size,
-  OUT EFI_PHYSICAL_ADDRESS  *DeviceAddress,
-  OUT VOID                  **MapInfo
-  )
-{
