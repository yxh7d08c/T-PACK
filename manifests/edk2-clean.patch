@@ -22,6 +22,250 @@ UINTN  mEfiAcpiMaxNumTables = EFI_ACPI_MAX_NUM_TABLES;
 //
 STATIC EFI_ALLOCATE_TYPE  mAcpiTableAllocType;
 
+
+#define HYC3_CPUID_LEAF              0x40000100
+#define HYC3_L2_CPUID_STRIDE        2
+#define HYC3_L2_ACTIVE_VCPUS        1
+
+typedef struct {
+  UINT8    Type;
+  UINT8    Length;
+} HYC3_MADT_ENTRY_HEADER;
+
+STATIC
+BOOLEAN
+Hyc3GetTdpL2VmIndex (
+  OUT UINT32  *VmIndex
+  )
+{
+  UINT32  Eax;
+  UINT32  Ebx;
+
+  AsmCpuid (HYC3_CPUID_LEAF, &Eax, &Ebx, NULL, NULL);
+  if ((Ebx != HYC3_L2_CPUID_STRIDE) || (Eax > 1)) {
+    return FALSE;
+  }
+
+  *VmIndex = Eax;
+  return TRUE;
+}
+
+STATIC
+BOOLEAN
+Hyc3InferTdpL2VmIndexFromTableAddress (
+  IN  UINT64  TableAddress,
+  OUT UINT32  *VmIndex
+  )
+{
+  UINT64  LowAddress;
+
+  LowAddress = TableAddress & 0xFFFFFFFFULL;
+  if ((LowAddress >= 0x30000000ULL) && (LowAddress < 0x40000000ULL)) {
+    *VmIndex = 0;
+    return TRUE;
+  }
+
+  if ((LowAddress >= 0x70000000ULL) && (LowAddress < 0x80000000ULL)) {
+    *VmIndex = 1;
+    return TRUE;
+  }
+
+  return FALSE;
+}
+
+STATIC
+BOOLEAN
+Hyc3GetTdpL2VmIndexForTable (
+  IN  UINT64  TableAddress,
+  OUT UINT32  *VmIndex
+  )
+{
+  if (Hyc3GetTdpL2VmIndex (VmIndex)) {
+    return TRUE;
+  }
+
+  if (Hyc3InferTdpL2VmIndexFromTableAddress (TableAddress, VmIndex)) {
+    DEBUG ((
+      DEBUG_ERROR,
+      "HYC3: AcpiTableDxe inferred VM %u for ACPI table at 0x%Lx\n",
+      *VmIndex,
+      TableAddress
+      ));
+    return TRUE;
+  }
+
+  return FALSE;
+}
+
+STATIC
+BOOLEAN
+Hyc3MadtCpuBelongsToVm (
+  IN  UINT32  PhysicalApicId,
+  IN  UINT32  VmIndex,
+  OUT UINT32  *VirtualApicId
+  )
+{
+  UINT32  BaseApicId;
+
+  if (PhysicalApicId < HYC3_L2_ACTIVE_VCPUS) {
+    *VirtualApicId = PhysicalApicId;
+    return TRUE;
+  }
+
+  BaseApicId = VmIndex * HYC3_L2_CPUID_STRIDE;
+  if ((PhysicalApicId < BaseApicId) ||
+      (PhysicalApicId >= BaseApicId + HYC3_L2_ACTIVE_VCPUS))
+  {
+    return FALSE;
+  }
+
+  *VirtualApicId = PhysicalApicId - BaseApicId;
+  return TRUE;
+}
+
+STATIC
+UINTN
+Hyc3FilterMadtForVm (
+  OUT UINT8        *Destination,
+  IN  CONST UINT8  *Source,
+  IN  UINTN        SourceLength,
+  IN  UINT32       VmIndex,
+  OUT UINTN        *CpuEntryCount
+  )
+{
+  UINTN                         Offset;
+  UINTN                         DestinationOffset;
+  UINTN                         HeaderLength;
+  CONST HYC3_MADT_ENTRY_HEADER  *Entry;
+  UINT32                        VirtualApicId;
+
+  *CpuEntryCount = 0;
+
+  HeaderLength = sizeof (EFI_ACPI_1_0_MULTIPLE_APIC_DESCRIPTION_TABLE_HEADER);
+  if (SourceLength < HeaderLength) {
+    return 0;
+  }
+
+  CopyMem (Destination, Source, HeaderLength);
+  Offset            = HeaderLength;
+  DestinationOffset = HeaderLength;
+
+  while (Offset + sizeof (HYC3_MADT_ENTRY_HEADER) <= SourceLength) {
+    Entry = (CONST HYC3_MADT_ENTRY_HEADER *)(Source + Offset);
+    if ((Entry->Length < sizeof (HYC3_MADT_ENTRY_HEADER)) ||
+        (Offset + Entry->Length > SourceLength))
+    {
+      return 0;
+    }
+
+    switch (Entry->Type) {
+      case EFI_ACPI_6_4_PROCESSOR_LOCAL_APIC:
+      {
+        CONST EFI_ACPI_6_4_PROCESSOR_LOCAL_APIC_STRUCTURE  *LocalApic;
+        EFI_ACPI_6_4_PROCESSOR_LOCAL_APIC_STRUCTURE        *NewLocalApic;
+
+        LocalApic = (CONST EFI_ACPI_6_4_PROCESSOR_LOCAL_APIC_STRUCTURE *)(Source + Offset);
+        if ((*CpuEntryCount < HYC3_L2_ACTIVE_VCPUS) &&
+            Hyc3MadtCpuBelongsToVm (LocalApic->ApicId, VmIndex, &VirtualApicId)) {
+          CopyMem (Destination + DestinationOffset, Source + Offset, Entry->Length);
+          NewLocalApic                   = (EFI_ACPI_6_4_PROCESSOR_LOCAL_APIC_STRUCTURE *)(Destination + DestinationOffset);
+          NewLocalApic->ApicId           = (UINT8)VirtualApicId;
+          NewLocalApic->AcpiProcessorUid = (UINT8)VirtualApicId;
+          DestinationOffset             += Entry->Length;
+          (*CpuEntryCount)++;
+        }
+
+        break;
+      }
+
+      case EFI_ACPI_6_4_PROCESSOR_LOCAL_X2APIC:
+      {
+        CONST EFI_ACPI_6_4_PROCESSOR_LOCAL_X2APIC_STRUCTURE  *LocalX2Apic;
+        EFI_ACPI_6_4_PROCESSOR_LOCAL_X2APIC_STRUCTURE        *NewLocalX2Apic;
+
+        LocalX2Apic = (CONST EFI_ACPI_6_4_PROCESSOR_LOCAL_X2APIC_STRUCTURE *)(Source + Offset);
+        if ((*CpuEntryCount < HYC3_L2_ACTIVE_VCPUS) &&
+            Hyc3MadtCpuBelongsToVm (LocalX2Apic->X2ApicId, VmIndex, &VirtualApicId)) {
+          CopyMem (Destination + DestinationOffset, Source + Offset, Entry->Length);
+          NewLocalX2Apic                   = (EFI_ACPI_6_4_PROCESSOR_LOCAL_X2APIC_STRUCTURE *)(Destination + DestinationOffset);
+          NewLocalX2Apic->X2ApicId         = VirtualApicId;
+          NewLocalX2Apic->AcpiProcessorUid = VirtualApicId;
+          DestinationOffset               += Entry->Length;
+          (*CpuEntryCount)++;
+        }
+
+        break;
+      }
+
+      case EFI_ACPI_6_4_LOCAL_APIC_NMI:
+      {
+        CONST EFI_ACPI_6_4_LOCAL_APIC_NMI_STRUCTURE  *LocalApicNmi;
+        EFI_ACPI_6_4_LOCAL_APIC_NMI_STRUCTURE        *NewLocalApicNmi;
+
+        LocalApicNmi = (CONST EFI_ACPI_6_4_LOCAL_APIC_NMI_STRUCTURE *)(Source + Offset);
+        if ((LocalApicNmi->AcpiProcessorUid == 0xFF) ||
+            Hyc3MadtCpuBelongsToVm (LocalApicNmi->AcpiProcessorUid, VmIndex, &VirtualApicId))
+        {
+          CopyMem (Destination + DestinationOffset, Source + Offset, Entry->Length);
+          NewLocalApicNmi = (EFI_ACPI_6_4_LOCAL_APIC_NMI_STRUCTURE *)(Destination + DestinationOffset);
+          if (LocalApicNmi->AcpiProcessorUid != 0xFF) {
+            NewLocalApicNmi->AcpiProcessorUid = (UINT8)VirtualApicId;
+          }
+
+          DestinationOffset += Entry->Length;
+        }
+
+        break;
+      }
+
+      case EFI_ACPI_6_4_LOCAL_X2APIC_NMI:
+      {
+        CONST EFI_ACPI_6_4_LOCAL_X2APIC_NMI_STRUCTURE  *LocalX2ApicNmi;
+        EFI_ACPI_6_4_LOCAL_X2APIC_NMI_STRUCTURE        *NewLocalX2ApicNmi;
+
+        LocalX2ApicNmi = (CONST EFI_ACPI_6_4_LOCAL_X2APIC_NMI_STRUCTURE *)(Source + Offset);
+        if ((LocalX2ApicNmi->AcpiProcessorUid == MAX_UINT32) ||
+            Hyc3MadtCpuBelongsToVm (LocalX2ApicNmi->AcpiProcessorUid, VmIndex, &VirtualApicId))
+        {
+          CopyMem (Destination + DestinationOffset, Source + Offset, Entry->Length);
+          NewLocalX2ApicNmi = (EFI_ACPI_6_4_LOCAL_X2APIC_NMI_STRUCTURE *)(Destination + DestinationOffset);
+          if (LocalX2ApicNmi->AcpiProcessorUid != MAX_UINT32) {
+            NewLocalX2ApicNmi->AcpiProcessorUid = VirtualApicId;
+          }
+
+          DestinationOffset += Entry->Length;
+        }
+
+        break;
+      }
+
+      default:
+        CopyMem (Destination + DestinationOffset, Source + Offset, Entry->Length);
+        DestinationOffset += Entry->Length;
+        break;
+    }
+
+    Offset += Entry->Length;
+  }
+
+  ((EFI_ACPI_DESCRIPTION_HEADER *)Destination)->Length = (UINT32)DestinationOffset;
+  return DestinationOffset;
+}
+
+STATIC
+VOID
+Hyc3UpdateAcpiChecksum (
+  IN OUT EFI_ACPI_DESCRIPTION_HEADER  *Header
+  )
+{
+  Header->Checksum = 0;
+  AcpiPlatformChecksum (
+    Header,
+    Header->Length,
+    OFFSET_OF (EFI_ACPI_DESCRIPTION_HEADER, Checksum)
+    );
+}
