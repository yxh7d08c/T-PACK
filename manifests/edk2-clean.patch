+#define HYC3_CPUID_LEAF             0x40000100
+#define HYC3_INVALID_VM_INDEX       0xffffffffU
+#define HYC3_PCI_MMIO32_BASE        0x80000000ULL
+#define HYC3_PCI_MMIO32_STRIDE      0x20000000ULL
+#define HYC3_PCI_MMIO32_SIZE        0x20000000ULL
+
+STATIC
+UINT32
+Hyc3GetVmIndex (
+  VOID
+  )
+{
+  UINT32  Eax;
+  UINT32  Ebx;
+
+  AsmCpuid (HYC3_CPUID_LEAF, &Eax, &Ebx, NULL, NULL);
+  if ((Ebx != 2) || (Eax > 1)) {
+    return HYC3_INVALID_VM_INDEX;
+  }
+
+  return Eax;
+}
+
+STATIC
+BOOLEAN
+Hyc3IsTdpL2Guest (
+  VOID
+  )
+{
+  return Hyc3GetVmIndex () != HYC3_INVALID_VM_INDEX;
+}
+
+VOID
+MemMapInitialization (
+  IN OUT EFI_HOB_PLATFORM_INFO  *PlatformInfoHob
+  )
+{
+  RETURN_STATUS  PcdStatus;
+  UINT32         Hyc3VmIndex;
+
+  PlatformMemMapInitialization (PlatformInfoHob);
+
+  if (PlatformInfoHob->HostBridgeDevId == 0xffff /* microvm */) {
+    return;
+  }
+
+  Hyc3VmIndex = Hyc3GetVmIndex ();
+  if ((Hyc3VmIndex != HYC3_INVALID_VM_INDEX) &&
+      (PlatformInfoHob->HostBridgeDevId == INTEL_Q35_MCH_DEVICE_ID)) {
+    PlatformInfoHob->PcdPciMmio32Base = HYC3_PCI_MMIO32_BASE +
+                                        (UINT64)Hyc3VmIndex * HYC3_PCI_MMIO32_STRIDE;
+    PlatformInfoHob->PcdPciMmio32Size = HYC3_PCI_MMIO32_SIZE;
+    DEBUG ((
+      DEBUG_INFO,
+      "HYC3: VM%u PCI MMIO32 aperture [0x%Lx, 0x%Lx)\n",
+      Hyc3VmIndex,
+      PlatformInfoHob->PcdPciMmio32Base,
+      PlatformInfoHob->PcdPciMmio32Base + PlatformInfoHob->PcdPciMmio32Size
+      ));
+  }
+
+  PcdStatus = PcdSet64S (PcdPciMmio32Base, PlatformInfoHob->PcdPciMmio32Base);
+  ASSERT_RETURN_ERROR (PcdStatus);
+  PcdStatus = PcdSet64S (PcdPciMmio32Size, PlatformInfoHob->PcdPciMmio32Size);
+  ASSERT_RETURN_ERROR (PcdStatus);
+
+  PcdStatus = PcdSet64S (PcdPciIoBase, PlatformInfoHob->PcdPciIoBase);
+  ASSERT_RETURN_ERROR (PcdStatus);
+  PcdStatus = PcdSet64S (PcdPciIoSize, PlatformInfoHob->PcdPciIoSize);
+  ASSERT_RETURN_ERROR (PcdStatus);
+}
+
+STATIC
+VOID
+NoexecDxeInitialization (
+  IN OUT EFI_HOB_PLATFORM_INFO  *PlatformInfoHob
+  )
+{
+  RETURN_STATUS  Status;
+
+  Status = PlatformNoexecDxeInitialization (PlatformInfoHob);
+  if (!RETURN_ERROR (Status)) {
+    Status = PcdSetBoolS (PcdSetNxForStack, PlatformInfoHob->PcdSetNxForStack);
+    ASSERT_RETURN_ERROR (Status);
+  }
+}
