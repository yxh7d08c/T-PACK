+#define HYC3_CPUID_LEAF             0x40000100
+#define HYC3_L2_MEMORY_SPLIT_BASE  0x20000000U
+#define HYC3_INVALID_VM_INDEX      0xffffffffU
+
+STATIC
+UINT32
+Hyc3GetVmIndex (
+  VOID
+  )
+{
+  UINT32  Eax;
+  UINT32  Ebx;
+
+  AsmCpuid (HYC3_CPUID_LEAF, &Eax, &Ebx, NULL, NULL);
+  if ((Ebx != 2) || (Eax > 1)) {
+    return HYC3_INVALID_VM_INDEX;
+  }
+
+  return Eax;
+}
