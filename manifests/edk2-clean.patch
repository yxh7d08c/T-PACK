+STATIC
+VOID
+Hyc3RegisterAcpiTableFilter (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  EFI_EVENT   QemuAcpiTableEvent;
+  VOID        *Registration;
+  VOID        *QemuAcpiTableNotifyProtocol;
+
+  Status = gBS->CreateEvent (
+                  EVT_NOTIFY_SIGNAL,
+                  TPL_CALLBACK,
+                  AlterAcpiTable,
+                  NULL,
+                  &QemuAcpiTableEvent
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "HYC3: failed to create ACPI table event: %r\n", Status));
+    return;
+  }
+
+  Status = gBS->RegisterProtocolNotify (
+                  &gQemuAcpiTableNotifyProtocolGuid,
+                  QemuAcpiTableEvent,
+                  &Registration
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "HYC3: failed to register ACPI table notify: %r\n", Status));
+    gBS->CloseEvent (QemuAcpiTableEvent);
+    return;
+  }
+
+  Status = gBS->LocateProtocol (
+                  &gQemuAcpiTableNotifyProtocolGuid,
+                  NULL,
+                  &QemuAcpiTableNotifyProtocol
+                  );
+  if (!EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_INFO, "HYC3: ACPI table notify already installed, filtering MADT now\n"));
+    AlterAcpiTable (QemuAcpiTableEvent, NULL);
+  }
+}
