-      (UINT64)(UINTN)HostAddress,
-      (UINT64)Size
-      ));
-    ASSERT (FALSE);
-    CpuDeadLoop ();
-  }
-
-  if (NumberOfBytes < Size) {
-    mIoMmuProtocol->Unmap (mIoMmuProtocol, Mapping);
-    DEBUG ((
-      DEBUG_ERROR,
-      "%a:%a failed to Map() - requested 0x%x got 0x%Lx\n",
