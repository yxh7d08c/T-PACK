+//
+// Static data that hosts the fw_cfg blobs and serves file requests.
+//
+typedef enum {
+  KernelBlobTypeKernel,
+  KernelBlobTypeInitrd,
+  KernelBlobTypeCommandLine,
+  KernelBlobTypeMax
+} KERNEL_BLOB_TYPE;
+
+typedef struct {
+  CONST CHAR16    Name[8];
+  struct {
+    FIRMWARE_CONFIG_ITEM          SizeKey;
+    FIRMWARE_CONFIG_ITEM          DataKey;
+    UINT32                        Size;
+  }                             FwCfgItem[2];
+  UINT32          Size;
+  UINT8           *Data;
+} KERNEL_BLOB;
+
+STATIC KERNEL_BLOB  mKernelBlob[KernelBlobTypeMax] = {
+  {
+    L"kernel",
+    {
+      { QemuFwCfgItemKernelSetupSize, QemuFwCfgItemKernelSetupData, },
+      { QemuFwCfgItemKernelSize,      QemuFwCfgItemKernelData,      },
+    }
+  },  {
+    L"initrd",
+    {
+      { QemuFwCfgItemInitrdSize,      QemuFwCfgItemInitrdData,      },
+    }
+  },  {
+    L"cmdline",
+    {
+      { QemuFwCfgItemCommandLineSize, QemuFwCfgItemCommandLineData, },
+    }
+  }
+};
+
+STATIC UINT64  mTotalBlobBytes;
+
+#define HYC3_CPUID_LEAF  0x40000100
+
+STATIC
+BOOLEAN
+Hyc3IsL22Guest (
+  VOID
+  )
+{
+  UINT32  Eax;
+  UINT32  Ebx;
+
+  AsmCpuid (HYC3_CPUID_LEAF, &Eax, &Ebx, NULL, NULL);
+  return (BOOLEAN)((Eax == 1) && (Ebx == 2));
+}
+
+STATIC
+EFI_STATUS
+Hyc3UseFwCfgFile (
+  IN  CONST CHAR8           *Name,
+  OUT FIRMWARE_CONFIG_ITEM  *Item,
+  OUT UINT32                *Size
+  )
+{
+  RETURN_STATUS  Status;
+  UINTN          FwCfgSize;
+
+  Status = QemuFwCfgFindFile (Name, Item, &FwCfgSize);
+  if (RETURN_ERROR (Status)) {
+    return EFI_NOT_FOUND;
+  }
+
+  if (FwCfgSize > MAX_UINT32) {
+    return EFI_BAD_BUFFER_SIZE;
+  }
+
+  *Size = (UINT32)FwCfgSize;
+  return EFI_SUCCESS;
+}
+
+STATIC
+VOID
+Hyc3ConfigureL22InitrdAndCmdline (
+  VOID
+  )
+{
+  KERNEL_BLOB           *Blob;
+  FIRMWARE_CONFIG_ITEM  Item;
+  UINT32                Size;
+
+  if (!Hyc3IsL22Guest ()) {
+    return;
+  }
+
+  Blob = &mKernelBlob[KernelBlobTypeKernel];
+  if (!EFI_ERROR (Hyc3UseFwCfgFile ("opt/setup2", &Item, &Size))) {
+    Blob->FwCfgItem[0].SizeKey = 0;
+    Blob->FwCfgItem[0].DataKey = Item;
+    Blob->FwCfgItem[0].Size    = Size;
+  }
+
+  if (!EFI_ERROR (Hyc3UseFwCfgFile ("opt/kernel2", &Item, &Size))) {
+    Blob->FwCfgItem[1].SizeKey = 0;
+    Blob->FwCfgItem[1].DataKey = Item;
+    Blob->FwCfgItem[1].Size    = Size;
+  }
+
+  Blob = &mKernelBlob[KernelBlobTypeInitrd];
+  if (!EFI_ERROR (Hyc3UseFwCfgFile ("opt/initrd2", &Item, &Size))) {
+    Blob->FwCfgItem[0].SizeKey = 0;
+    Blob->FwCfgItem[0].DataKey = Item;
+    Blob->FwCfgItem[0].Size    = Size;
+  }
+
+  Blob = &mKernelBlob[KernelBlobTypeCommandLine];
+  if (!EFI_ERROR (Hyc3UseFwCfgFile ("opt/cmdline2", &Item, &Size))) {
+    Blob->FwCfgItem[0].SizeKey = 0;
+    Blob->FwCfgItem[0].DataKey = Item;
+    Blob->FwCfgItem[0].Size    = Size;
+  }
+}
+
+
+STATIC
+VOID
+Hyc3ReadBlobRangeFromFwCfg (
+  IN CONST KERNEL_BLOB  *Blob,
+  IN UINT64             Offset,
+  IN UINTN              Size,
+  OUT VOID              *Buffer
+  )
+{
+  UINTN   Idx;
+  UINT64  BlobOffset;
+  UINT64  Remaining;
+  UINT8   *Out;
+
+  BlobOffset = 0;
+  Remaining  = Size;
+  Out        = (UINT8 *)Buffer;
+
+  for (Idx = 0; Idx < ARRAY_SIZE (Blob->FwCfgItem); Idx++) {
+    UINT64  ItemStart;
+    UINT64  ItemEnd;
+    UINT64  ItemOffset;
+    UINT64  Available;
+    UINTN   Chunk;
+
+    if ((Remaining == 0) || (Blob->FwCfgItem[Idx].DataKey == 0)) {
+      break;
+    }
+
+    ItemStart = BlobOffset;
+    ItemEnd   = ItemStart + Blob->FwCfgItem[Idx].Size;
+    if (Offset >= ItemEnd) {
+      BlobOffset = ItemEnd;
+      continue;
+    }
+
+    ItemOffset = (Offset > ItemStart) ? (Offset - ItemStart) : 0;
+    Available  = Blob->FwCfgItem[Idx].Size - ItemOffset;
+    Chunk      = (Remaining < Available) ? (UINTN)Remaining : (UINTN)Available;
+
+    QemuFwCfgSelectItem (Blob->FwCfgItem[Idx].DataKey);
+    if (ItemOffset != 0) {
+      QemuFwCfgSkipBytes ((UINTN)ItemOffset);
+    }
+
+    QemuFwCfgReadBytes (Chunk, Out);
+    Out       += Chunk;
+    Offset    += Chunk;
+    Remaining -= Chunk;
+    BlobOffset = ItemEnd;
+  }
+}
