+static bool hyc3_tdx_l2_1_requester_id(uint32_t requester_id)
+{
+#ifdef TARGET_I386
+    uint8_t bus = requester_id >> 8;
+    uint8_t devfn = requester_id & 0xff;
+    uint8_t slot = PCI_SLOT(devfn);
+
+    return is_tdx_vm() && bus == 0 && (slot == 3 || slot == 5);
+#else
+    return false;
+#endif
+}
+
+static bool hyc3_tdx_l2_2_requester_id(uint32_t requester_id)
+{
+#ifdef TARGET_I386
+    uint8_t bus = requester_id >> 8;
+    uint8_t devfn = requester_id & 0xff;
+    uint8_t slot = PCI_SLOT(devfn);
+
