+ * Keep this as a real single-target xAPIC logical destination.  Dest 2 can be
+ * used by L2-1's second logical CPU, while 0xfe fans out to multiple HYC3 VPs
+ * and causes empty SIRTE drains.  Dest 4 maps to the L2-2 BSP/APIC2 logical bit;
+ * the SVSM rewrites it back to guest-local dest 1 before injecting into L2-2.
+ */
+#define HYC3_L2_2_MSI_DEST_ID       4ULL
